{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel Preview Server",
            "type": "shell",
            "command": "php artisan serve --host=127.0.0.1 --port=8012",
            "isBackground": true,
            "problemMatcher": {
                "owner": "php",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Server running on"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
