{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "cross-env NODE_OPTIONS=--openssl-legacy-provider node node_modules/laravel-mix/bin/cli.js --no-progress",
        "watch": "cross-env NODE_OPTIONS=--openssl-legacy-provider node node_modules/laravel-mix/bin/cli.js --no-progress watch",
        "watch-poll": "cross-env NODE_OPTIONS=--openssl-legacy-provider node node_modules/laravel-mix/bin/cli.js --no-progress watch -- --watch-options-poll=1000",
        "hot": "cross-env NODE_OPTIONS=--openssl-legacy-provider node node_modules/laravel-mix/bin/cli.js --no-progress watch --hot",
        "prod": "npm run production",
        "production": "cross-env NODE_OPTIONS=--openssl-legacy-provider node node_modules/laravel-mix/bin/cli.js --no-progress --production"
    },
    "devDependencies": {
        "axios": "^0.21",
        "bootstrap": "^4.0.0",
        "cross-env": "^10.1.0",
        "jquery": "^3.2",
        "laravel-mix": "^6.0.49",
        "lodash": "^4.17.19",
        "popper.js": "^1.12",
        "postcss": "^8.4.31",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.20.1",
        "sass-loader": "^8.0.0",
        "vue": "^2.5.17",
        "vue-loader": "^15.10.0",
        "vue-template-compiler": "^2.6.10",
        "webpack": "^5.75.0"
    },
    "dependencies": {
        "font-awesome": "^4.7.0"
    }
}
